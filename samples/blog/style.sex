;; The site's stylesheet. Render it alone with `seam --css style.sex`.
(html
  :--text "#222"
  :--muted "#666"
  :--accent "#b5452b"
  :--background "#fdfcf9")

(body
  :max-width 42rem
  :margin (0 auto)
  :padding (0 1rem)
  :font-family (Charter, Georgia, serif)
  :line-height 1.6
  :color (var --text)
  :background (var --background))

(header
  :display flex
  :flex-wrap wrap
  :justify-content space-between
  :align-items baseline
  :padding (1.5rem 0)
  :border-bottom (1px solid "#ddd"))

(header .site-title
  :font-size 1.4rem
  :font-weight bold
  :color (var --text)
  :text-decoration none)

(nav a :margin-left 1rem)

(a :color (var --accent))

(.meta
  :color (var --muted)
  :font-size 0.9rem)

(.summary :margin (2rem 0))
(.summary h2 :margin-bottom 0)
(.summary h2 a
  :color (var --text)
  :text-decoration none)

(pre
  :padding 1rem
  :overflow-x auto
  :background "#f3f1ec")

(footer
  :margin-top 3rem
  :padding (1rem 0)
  :border-top (1px solid "#ddd")
  :color (var --muted)
  :font-size 0.9rem)
