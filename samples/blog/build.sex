;; Builds the whole site into `public/`, next to this file:
;;   seam run build.sex
;; Each page is generated with a formatter macro, and written with `%write`.
(%include "site.sex")

;; Where to write the site, from wherever seam is run.
(%define public (%path/relative (%path/join (%path/here) public)))

(%define (write/html path &content)
  (%write (%path/join %public %path) (%formatter/html :document true %content)))

(%write/html "index.html" (%include "index.sex"))
(%write/html "tags.html" (%include "tags.sex"))

(%for post in %posts
  (%write/html (%concat "posts/" (%get slug %post) ".html")
    (%with %post
      (%with (:root "../")
        (%include "post.sex")))))

(%write (%path/join %public feed.xml) (%formatter/xml :document true (%include "feed.sex")))
(%write (%path/join %public style.css) (%formatter/css (%include "style.sex")))

(%log Built (%length %posts) posts into %public)
