;; An RSS feed of the posts. Render it alone with `seam --xml feed.sex`.
(%include "site.sex")

(%define (rfc-822 date)
  (%date "%a, %d %b %Y %H:%M:%S +0000" (%timestamp "%Y-%m-%d" %date :timezone 0) :timezone 0))

(rss :version "2.0"
  (channel
    (title %site-title)
    (link %site-url)
    (description Notes on building websites with seam.)
    (%for post in %posts
      (%let (((:slug _ :title _ :date _ :description _ &&_) %post)
             (url (%concat %site-url "posts/" %slug ".html")))
        (item
          (title %title)
          (link %url)
          (guid %url)
          (pubDate (%rfc-822 %date))
          (description %description))))))
